# PostgreSQL Database Connection URL (for production or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ras_properties?schema=public"

# Auth / NextAuth Secret
AUTH_SECRET="your-production-secret-key-at-least-32-chars-long"
JWT_SECRET="your-production-secret-key-at-least-32-chars-long"

# Public App URL
NEXT_PUBLIC_APP_URL="https://rasproperties.in"

# Google Maps API Key
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend Email Service
RESEND_API_KEY="re_123456789"
EMAIL_FROM="RAS Properties <noreply@rasproperties.in>"

# Demo Admin Initial Setup
ADMIN_EMAIL="admin@rasproperties.in"
ADMIN_PASSWORD="AdminPassword@2026"
